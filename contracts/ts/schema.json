        "camera_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limit": {
          "default": 10,
          "type": "integer"
        },
        "unresolved": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Referent"
          },
          "type": "array"
        },
        "source": {
          "default": "llm",
          "enum": [
            "fastpath",
            "llm",
            "local_llm",
            "cache"
          ],
          "type": "string"
        }
      },
      "required": [
        "intent"
      ],
      "title": "QueryPlan",
      "type": "object"
    },
    "Referent": {
      "properties": {
        "text": {
          "type": "string"
        },
        "role": {
          "enum": [
            "place",
            "object",
            "time"
          ],
          "type": "string"
        }
      },
      "required": [
        "text",
        "role"
      ],
      "title": "Referent",
      "type": "object"
    },
    "Target": {
      "properties": {
        "noun": {
          "type": "string"
        },
        "cls": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "attributes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "embed_text": {
          "type": "string"
        },
        "example_track_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "noun",
        "embed_text"
      ],
      "title": "Target",
      "type": "object"
    },
    "TimeWindow": {
      "properties": {
        "start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "phrase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tod_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tod_before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "TimeWindow",
      "type": "object"
    },
    "Answer": {
      "properties": {
        "query_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "yes",
            "no",
            "found",
            "not_found",
            "partial",
            "count"
          ],
          "type": "string"
        },
        "count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "path": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PathHop"
          },
          "type": "array"
        },
        "nearest_miss": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "type": "number"
        },
        "plan": {
          "$ref": "#/$defs/QueryPlan"
        },
        "timings_ms": {
          "additionalProperties": {
            "type": "number"
          },
          "default": {},
          "type": "object"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unsupported_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
