          "type": "string"
        },
        "source_uri": {
          "type": "string"
        },
        "fps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "t0": {
          "type": "number"
        },
        "t0_source": {
          "enum": [
            "filename",
            "metadata",
            "osd",
            "slate",
            "manual",
            "live"
          ],
          "type": "string"
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "site_xy": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "type": "array",
              "items": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "ingesting",
            "ready",
            "live",
            "error"
          ],
          "type": "string"
        },
        "layers": {
          "default": [],
          "items": {
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "ir_fraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
