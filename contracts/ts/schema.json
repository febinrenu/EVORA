        "why": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "camera_id",
        "camera_name",
        "t_start",
        "t_end",
        "t_peak",
        "offset_s",
        "thumb_url",
        "clip_url",
        "score"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Alert": {
      "properties": {
        "id": {
          "type": "string"
        },
        "standing_query_id": {
          "type": "string"
        },
        "t": {
          "type": "number"
        },
        "camera_id": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "acknowledged": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "standing_query_id",
        "t",
        "camera_id",
        "evidence"
      ],
      "title": "Alert",
      "type": "object"
    },
    "PathHop": {
      "properties": {
        "camera_id": {
          "type": "string"
        },
        "camera_name": {
          "type": "string"
        },
        "t_in": {
          "type": "number"
        },
        "t_out": {
          "type": "number"
        },
        "evidence_id": {
          "type": "string"
        }
      },
      "required": [
        "camera_id",
        "camera_name",
        "t_in",
        "t_out",
        "evidence_id"
      ],
      "title": "PathHop",
      "type": "object"
    },
    "QueryPlan": {
      "properties": {
        "intent": {
          "enum": [
            "exists",
            "list",
            "count",
            "first",
            "last",
            "path",
            "describe",
            "standing"
          ],
          "type": "string"
        },
        "targets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Target"
          },
          "type": "array"
        },
        "place": {
          "anyOf": [
            {
              "$ref": "#/$defs/Referent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "action": {
          "default": "any",
          "enum": [
            "any",
            "pass_through",
            "enter",
            "exit",
            "dwell",
            "appear"
          ],
          "type": "string"
        },
        "time": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
