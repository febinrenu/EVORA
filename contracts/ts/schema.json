    "PathHop": {
      "$ref": "#/$defs/PathHop"
    },
    "QueryPlan": {
      "$ref": "#/$defs/QueryPlan"
    },
    "Referent": {
      "$ref": "#/$defs/Referent"
    },
    "Target": {
      "$ref": "#/$defs/Target"
    },
    "TimeWindow": {
      "$ref": "#/$defs/TimeWindow"
    },
    "Answer": {
      "$ref": "#/$defs/Answer"
    },
    "CameraInfo": {
      "$ref": "#/$defs/CameraInfo"
    },
    "CameraOption": {
      "$ref": "#/$defs/CameraOption"
    },
    "ClarifyRequest": {
      "$ref": "#/$defs/ClarifyRequest"
    },
    "Zone": {
      "$ref": "#/$defs/Zone"
    },
    "ClarifyResponse": {
      "$ref": "#/$defs/ClarifyResponse"
    },
    "IngestJob": {
      "$ref": "#/$defs/IngestJob"
