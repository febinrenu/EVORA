        "id": {
          "type": "string"
        },
        "camera_id": {
          "type": "string"
        },
        "camera_name": {
          "type": "string"
        },
        "t_start": {
          "type": "number"
        },
        "t_end": {
          "type": "number"
        },
        "t_peak": {
          "type": "number"
        },
        "offset_s": {
          "type": "number"
        },
        "track_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "global_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "type": "array",
              "items": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ]
            },
            {
              "type": "null"
