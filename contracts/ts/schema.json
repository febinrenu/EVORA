        "carrying": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "size_rel": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "is_ir": {
          "default": false,
          "type": "boolean"
        }
