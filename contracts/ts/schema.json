    "Evidence",
    "Alert",
    "PathHop",
    "QueryPlan",
    "Referent",
    "Target",
    "TimeWindow",
    "Answer",
    "CameraInfo",
    "CameraOption",
    "ClarifyRequest",
    "Zone",
    "ClarifyResponse",
    "IngestJob",
    "MemoryFact",
    "StandingQuery",
    "StreamEvent",
    "TrackAttrs"
  ],
  "additionalProperties": false,
