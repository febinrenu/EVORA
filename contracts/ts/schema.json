    "StreamEvent": {
      "properties": {
        "type": {
          "enum": [
            "plan",
            "clarify",
            "evidence",
            "answer",
            "verified",
            "note",
            "error",
            "done"
          ],
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "type",
        "data"
      ],
      "title": "StreamEvent",
      "type": "object"
    },
    "TrackAttrs": {
      "properties": {
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "color_conf": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "upper_color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lower_color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vehicle_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
