      "required": [
        "id",
        "name",
        "kind",
        "source_uri",
        "t0",
        "t0_source"
      ],
      "title": "CameraInfo",
      "type": "object"
    },
    "CameraOption": {
      "properties": {
        "camera_id": {
          "type": "string"
        },
        "camera_name": {
          "type": "string"
        },
        "thumb_url": {
          "type": "string"
        }
      },
      "required": [
        "camera_id",
        "camera_name",
        "thumb_url"
      ],
      "title": "CameraOption",
      "type": "object"
    },
    "ClarifyRequest": {
      "properties": {
        "query_id": {
          "type": "string"
        },
        "referent": {
          "$ref": "#/$defs/Referent"
        },
        "question": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "choose_camera",
            "choose_known",
            "choose_track",
            "time_range"
          ],
          "type": "string"
        },
        "options": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CameraOption"
          },
          "type": "array"
        },
        "known_candidates": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allow_region": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "query_id",
        "referent",
        "question",
        "kind"
      ],
      "title": "ClarifyRequest",
      "type": "object"
    },
    "Zone": {
      "properties": {
        "id": {
          "type": "string"
        },
        "camera_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "line",
            "polygon",
            "frame"
          ],
          "type": "string"
        },
        "points": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "type": "array",
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ]
          },
          "type": "array"
        },
        "direction": {
          "default": "any",
          "enum": [
            "any",
            "a_to_b",
            "b_to_a"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "camera_id",
        "kind"
      ],
      "title": "Zone",
      "type": "object"
    },
    "ClarifyResponse": {
      "properties": {
        "query_id": {
          "type": "string"
        },
        "camera_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "zone": {
          "anyOf": [
            {
              "$ref": "#/$defs/Zone"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "track_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tod_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tod_before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "query_id"
      ],
      "title": "ClarifyResponse",
      "type": "object"
    },
    "IngestJob": {
      "properties": {
        "id": {
          "type": "string"
        },
        "camera_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "done",
            "error"
          ],
          "type": "string"
        },
        "layer": {
          "anyOf": [
            {
              "enum": [
                "L0",
                "L1",
                "L2",
                "L3"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "progress": {
          "default": 0.0,
          "type": "number"
        },
        "video_s_per_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "camera_id",
        "state"
      ],
      "title": "IngestJob",
      "type": "object"
    },
    "MemoryFact": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "place",
            "object",
            "time"
          ],
          "type": "string"
        },
        "canonical": {
          "type": "string"
        },
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "inferred_aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "binding": {
          "additionalProperties": true,
          "type": "object"
        },
        "source": {
          "enum": [
            "clarification",
            "statement",
            "correction",
            "import"
          ],
          "type": "string"
        },
        "created_at": {
          "type": "number"
        },
        "last_used_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "use_count": {
          "default": 0,
          "type": "integer"
        },
        "superseded_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "canonical",
        "binding",
        "source",
        "created_at"
      ],
      "title": "MemoryFact",
      "type": "object"
    },
    "StandingQuery": {
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "rule": {
          "additionalProperties": true,
          "type": "object"
        },
        "active": {
          "default": true,
          "type": "boolean"
        },
        "created_at": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "text",
        "rule",
        "created_at"
      ],
