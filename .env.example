GROQ_KEYS=                 # comma separated, one key per member from their own Groq account
evora_WORKSPACE=own-campus
evora_PROFILE=cpu          # gpu | cpu | mps
evora_ONPREM=0
OLLAMA_HOST=http://127.0.0.1:11434
HF_HOME=./models/hf
NTFY_TOPIC=
# Local models (Ollama). The 4B vision model needs about 7.7 GB of GPU memory next to SigLIP2, YOLO and OSNet,
# so on a laptop GPU keep one model resident: OLLAMA_MAX_LOADED_MODELS=1
# OLLAMA_VISION_MODEL=qwen3-vl:4b
# OLLAMA_TEXT_MODEL=qwen3.5:4b
OLLAMA_MAX_LOADED_MODELS=1
